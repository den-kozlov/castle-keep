{
  "source": {
    "module": "github",
    "repo": "den-kozlov/castle-keep",
    "ready": "ready-for-agent",
    "human": "ready-for-human",
    "triage": "needs-triage"
  },
  "sandbox": {
    "module": "no-sandbox"
  },
  "roles": {
    "planner": {
      "agent": "claude-code",
      "model": "claude-haiku-5-5"
    },
    "implementer": {
      "agent": "claude-code",
      "model": "claude-opus-5-5",
      "effort": "low"
    },
    "reviewer": {
      "agent": "claude-code",
      "model": "claude-opus-5-5",
      "effort": "medium"
    },
    "merger": {
      "agent": "claude-code",
      "model": "claude-haiku-5-5"
    }
  },
  "prompts": {
    "plan": "./.sandcastle/plan-prompt.md",
    "implement": "./.sandcastle/implement-prompt.md",
    "review": "./.sandcastle/review-prompt.md",
    "merge": "./.sandcastle/merge-prompt.md"
  },
  "gates": [
    "npm run typecheck",
    "npm run build",
    "npm test"
  ],
  "hooks": {
    "sandbox.worktreeBuildup": [
      "npm ci && npm run build"
    ],
    "host.worktreeTeardown": [
      "rm -rf \"$CASTLE_KEEP_WORKTREE/node_modules\""
    ]
  },
  "plugins": [
    {
      "module": "claude-limits"
    },
    {
      "module": "github-pr"
    },
    {
      "module": "orca"
    }
  ]
}
